APP_NAME="PAC ESCOM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Procesos de «php artisan serve» (más de 1 para demostraciones con varios celulares o pruebas de carga)
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pac
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@pac-escom.mx"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- PAC ---
APP_TIMEZONE=America/Mexico_City
PAC_VERIFICAR_CORREO=false
PAC_DATOS_DEMO=false
PAC_SUPERADMIN_CORREO=superadmin@ipn.mx
PAC_SUPERADMIN_PASSWORD=CambiaEsto2026

# Reglas de negocio (valores del plan de proyecto; se pueden ajustar sin tocar el código)
PAC_MAX_INSCRIPCIONES=5
PAC_AVISO_CUPO=90
PAC_HORAS_CANCELACION=24
PAC_SEGUNDOS_QR=30
PAC_INTENTOS_LOGIN=5
PAC_MINUTOS_BLOQUEO=5

# Respaldos (php artisan pac:respaldo)
PAC_RESPALDOS_CONSERVAR=7
# PAC_PG_DUMP=/usr/bin/pg_dump

# Seguridad
PAC_CSP=true
# Solo si el hosting pone la aplicación detrás de un proxy HTTPS (Render, Railway…): PAC_PROXIES_CONFIABLES=*
# PAC_PROXIES_CONFIABLES=

# --- Producción (hosting): cambia estos valores ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tu-dominio
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=warning
# QUEUE_CONNECTION=database   (y ejecuta «php artisan queue:work»)
